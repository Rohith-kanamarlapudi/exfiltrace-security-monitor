# ── Node / Frontend ─────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# npm/yarn/pnpm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
.env/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
*.egg-info/

# ── ExfilTrace runtime artifacts ─────────────────────────────────────────────
# SQLite databases (generated at runtime – do not commit)
*.db
*.db-wal
*.db-shm
*.db-journal

# Packet capture files
*.pcap
*.pcapng
*.cap

# ── Environment / Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
*.secret

